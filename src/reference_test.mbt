  let db = @moonseqmine.database([
    [[1]],
    [[1], [0], [3], [3]],
    [[0], [3], [1], [0], [3]],
    [[3], [1], [0]],
  ])
  let actual : Map[String, Int32] = Map([])
  for record in @moonseqmine.mine(db, @moonseqmine.options(2, max_items=4)) {
    actual[@moonseqmine.pattern_key(record.pattern)] = record.support
  }
  assert_eq(
    actual,
    Map([
      ("0", 3),
      ("0;3", 2),
      ("0;3;3", 2),
      ("1", 4),
      ("1;0", 3),
      ("1;0;3", 2),
      ("1;3", 2),
      ("3", 3),
      ("3;0", 2),
      ("3;1", 2),
      ("3;1;0", 2),
      ("3;3", 2),
    ]),
  )
}

///|
test "Python PrefixSpan scalar differential 63/1" {
  let db = @moonseqmine.database([[[2], [1]], [[1], [2]], [], [[3], [1]]])
  let actual : Map[String, Int32] = Map([])
  for record in @moonseqmine.mine(db, @moonseqmine.options(1, max_items=4)) {
    actual[@moonseqmine.pattern_key(record.pattern)] = record.support
  }
  assert_eq(
    actual,
    Map([("1", 3), ("1;2", 1), ("2", 2), ("2;1", 1), ("3", 1), ("3;1", 1)]),
  )
}

///|
test "Python PrefixSpan scalar differential 63/2" {
  let db = @moonseqmine.database([[[2], [1]], [[1], [2]], [], [[3], [1]]])
  let actual : Map[String, Int32] = Map([])
  for record in @moonseqmine.mine(db, @moonseqmine.options(2, max_items=4)) {
    actual[@moonseqmine.pattern_key(record.pattern)] = record.support
  }
  assert_eq(actual, Map([("1", 3), ("2", 2)]))
}
